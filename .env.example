# Data adapter mode: "insforge" (InsForge BaaS), "local" (browser localStorage), or "api" (custom REST backend)
VITE_DATA_SOURCE=insforge

# InsForge project URL and anon key (set in .env.local; never commit real keys)
VITE_INSFORGE_URL=https://your-appkey.region.insforge.app
VITE_INSFORGE_ANON_KEY=MY_INSFORGE_ANON_KEY

# Optional base URL for custom REST backend when VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:4000
